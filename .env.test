# E2E test environment for the gateway — points at the same isolated test
# database/redis-db that the backoffice's Playwright suite uses (`ev_rental_go_test`,
# redis logical db 1), so MQTT messages published by @gateway specs land where the
# backoffice's test-mode server (port 3100) can actually see them. Same Mosquitto
# broker as dev — MQTT is just transport, doesn't need its own isolated instance.
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=iot_gateway
MQTT_PASSWORD=secret

REDIS_URL=redis://localhost:6379/1

DATABASE_URL=postgresql://postgres:123456789@localhost:5432/ev_rental_go_test

OFFLINE_TIMEOUT_SECONDS=300
TELEMETRY_BATCH_SIZE=10
TELEMETRY_BATCH_INTERVAL_MS=2000

# Distinct from the dev gateway's 3001 so both can run side by side.
PORT=3101
